    {
      "id": "derived-failed",
      "kind": "failed",
      "family": "pgm01-v1",
      "retained_path": "records/derived-failed.json",
      "origin": {
        "repository": "agent-ix/quire-contract-ir",
        "revision": "8e0953ecd849c223768fc632972f2c49fa149d54",
        "path": "evidence/pgm-01-02568b1/manifest.json",
        "recorded_sha256": "9d80da2cc897059ccdc64904bcdc7b0683f27ae667e03941800c3587112dc93d"
      },
      "derivation": {
        "from": "legacy-v1-passing",
        "operation": "/checks/0/status: 'pass' -> 'fail'",
        "reason": "PGM-01 history records no failed check. A failing legacy record has to exist in the corpus, so one is constructed from real bytes by a single named edit rather than written from imagination."
      },
      "expected": {
        "outcome": "lossy",
        "required_mappings": [
          {
            "source_path": "/checks/0/status",
            "value": "failed"
          }
        ],
        "note": "A failed legacy check maps to failed and stays failed."
      }
    },
    {
      "id": "derived-unavailable",
      "kind": "unavailable",
      "family": "pgm01-v1",
      "retained_path": "records/derived-unavailable.json",
      "origin": {
        "repository": "agent-ix/quire-contract-ir",
        "revision": "8e0953ecd849c223768fc632972f2c49fa149d54",
        "path": "evidence/pgm-01-02568b1/manifest.json",
        "recorded_sha256": "9d80da2cc897059ccdc64904bcdc7b0683f27ae667e03941800c3587112dc93d"
      },
      "derivation": {
        "from": "legacy-v1-passing",
        "operation": "/checks/0/status: 'pass' -> 'unavailable'",
        "reason": "PGM-01 history records no unavailable check."
      },
      "expected": {
        "outcome": "lossy",
        "required_mappings": [
          {
            "source_path": "/checks/0/status",
            "value": "unavailable"
          }
        ],
        "note": "Unavailable is neither passed nor failed and is not collapsed into either."
      }
    },
    {
      "id": "derived-not-computed",
      "kind": "not_computed",
      "family": "pgm01-v1",
      "retained_path": "records/derived-not-computed.json",
      "origin": {
        "repository": "agent-ix/quire-contract-ir",
        "revision": "8e0953ecd849c223768fc632972f2c49fa149d54",
        "path": "evidence/pgm-01-02568b1/manifest.json",
        "recorded_sha256": "9d80da2cc897059ccdc64904bcdc7b0683f27ae667e03941800c3587112dc93d"
      },
      "derivation": {
        "from": "legacy-v1-passing",
        "operation": "/checks/0/status: 'pass' -> 'not_computed'",
        "reason": "The shared model carries not_computed; PGM-01 v1 has no such status and its mapper does not know one. The expected outcome records that refusal rather than inventing a translation for it."
      },
      "expected": {
        "outcome": "unreadable",
        "required_unmapped_reason": "unknown",
        "note": "A legacy status the mapping does not know is refused. Not-computed reaches the shared model through a current-model producer record, not through a PGM-01 back-translation."
      }
    },
